rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isSessionParticipant(sessionId) {
      return signedIn()
        && request.auth.uid in firestore.get(/databases/(default)/documents/sessions/$(sessionId)).data.participantUids;
    }

    match /resumes/{uid}/{resumeId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if signedIn() && request.auth.uid == uid;
    }

    match /profiles/{uid}/{fileName} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if signedIn() && request.auth.uid == uid;
    }

    match /recordings/{sessionId}/{fileName} {
      allow read: if isAdmin() || isSessionParticipant(sessionId);
      allow write: if isSessionParticipant(sessionId);
    }

    match /reports/{sessionId}/{fileName} {
      allow read: if isAdmin() || isSessionParticipant(sessionId);
      allow write: if isAdmin();
    }
  }
}
