MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority&appName=<app-name>
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
FRONTEND_URL=https://arahinfotech-interview.web.app
FRONTEND_URLS=https://arahinfotech-interview.web.app,https://arahinfotech-interview.firebaseapp.com
SOCKETIO_CORS_ORIGINS=https://arahinfotech-interview.web.app,https://arahinfotech-interview.firebaseapp.com
UPLOAD_ROOT=/tmp/ai-interview
GRIDFS_ENABLED=true
GRIDFS_BUCKET=interview_recordings
FIREBASE_PROJECT_ID=your-project-id
# Prefer setting this via Google Secret Manager; never commit real credentials.
FIREBASE_ADMIN_CREDENTIALS_JSON=

# Optional email integration.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=AI Adaptive Interview

# Local development only. Leave unset in production.
USE_MOCK_MONGO=
